#include <stdlib.h>
#include <math.h>

int* leftRightDifference(int* nums, int numsSize, int* returnSize) {
    *returnSize = numsSize;

    int *answer = (int*)malloc(numsSize * sizeof(int));

    int totalSum = 0;
    for (int i = 0; i < numsSize; i++) {
        totalSum += nums[i];
    }

    int leftSum = 0;

    for (int i = 0; i < numsSize; i++) {
        totalSum -= nums[i];   // rightSum

        answer[i] = abs(leftSum - totalSum);

        leftSum += nums[i];
    }

    return answer;
}
